{
  "$description": "songdj design tokens — W3C Design Tokens (DTCG) format. Source of truth in code: src/app/win98.ts",
  "color": {
    "$type": "color",
    "neutral": {
      "black":        { "$value": "#000000" },
      "shadow-dark":  { "$value": "#262626" },
      "shadow":       { "$value": "#7E7E7E", "$description": "DIM" },
      "light-shadow": { "$value": "#B1B1B1" },
      "face":         { "$value": "#C3C3C3", "$description": "FACE" },
      "highlight":    { "$value": "#F0F0F0" },
      "white":        { "$value": "#FFFFFF" }
    },
    "desktop":   { "$value": "#008080", "$description": "DESK" },
    "selection": { "$value": "#000080" },
    "title": {
      "start":          { "$value": "#000080" },
      "end":            { "$value": "#1084D0" },
      "inactive-bg":    { "$value": "{color.neutral.shadow}" },
      "inactive-text":  { "$value": "{color.neutral.face}" }
    },
    "deck": {
      "a": { "$value": "#001CF5", "$description": "CA" },
      "b": { "$value": "#EB3323", "$description": "CB" }
    },
    "feedback": {
      "success": { "$value": "#008000", "$description": "COMPAT_OK / PERFECT" },
      "warning": { "$value": "#806000", "$description": "COMPAT_MID / HARMONIC" },
      "danger":  { "$value": "#C00000", "$description": "COMPAT_BAD / CLASH, erros" }
    }
  },
  "font": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["W95FA", "MS Sans Serif", "Tahoma", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "xs":      { "$value": "11px" },
      "sm":      { "$value": "12px", "$description": "base" },
      "md":      { "$value": "13px", "$description": "title bar" },
      "lg":      { "$value": "14px" },
      "xl":      { "$value": "18px" },
      "display": { "$value": "32px" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "2px" },
    "2": { "$value": "4px" },
    "3": { "$value": "6px" },
    "4": { "$value": "8px" },
    "5": { "$value": "10px" },
    "6": { "$value": "12px" },
    "7": { "$value": "18px" }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": "14px", "$description": "caption button height (16 wide)" },
      "md": { "$value": "20px", "$description": "list row, menu item" },
      "lg": { "$value": "23px", "$description": "default button, tab" },
      "xl": { "$value": "44px", "$description": "pad" }
    },
    "titlebar":  { "$value": "18px" },
    "statusbar": { "$value": "22px" },
    "taskbar":   { "$value": "28px" },
    "trackbar":  { "$value": "21px" },
    "button-min-width": { "$value": "75px" },
    "scrollbar": { "$value": "16px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" }
  },
  "shadow": {
    "$type": "string",
    "raised":  { "$value": "inset -1px -1px #262626, inset 1px 1px #F0F0F0, inset -2px -2px #7E7E7E" },
    "window":  { "$value": "inset -1px -1px #262626, inset 1px 1px #B1B1B1, inset -2px -2px #7E7E7E, inset 2px 2px #F0F0F0" },
    "sunken":  { "$value": "inset -1px -1px #F0F0F0, inset 1px 1px #262626, inset -2px -2px #B1B1B1, inset 2px 2px #7E7E7E" },
    "field":   { "$value": "inset 1px 1px #7E7E7E, inset -1px -1px #F0F0F0, inset 2px 2px #262626, inset -2px -2px #B1B1B1" },
    "status":  { "$value": "inset -1px -1px #F0F0F0, inset 1px 1px #7E7E7E" },
    "etched":  { "$value": "inset 1px 1px #F0F0F0, 1px 1px #F0F0F0", "$description": "used with border: 1px solid #7E7E7E" }
  },
  "gradient": {
    "title-bar": { "$type": "string", "$value": "linear-gradient(90deg, #000080, #1084D0)" }
  },
  "z-index": {
    "$type": "number",
    "dropdown":     { "$value": 5 },
    "dialog":       { "$value": 10 },
    "float-window": { "$value": 1000 }
  }
}
